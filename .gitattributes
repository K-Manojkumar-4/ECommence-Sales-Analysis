# Force GitHub to count SQL files in the language stats
*.sql linguist-detectable=true
*.sql linguist-language=SQL

# Normalize line endings for all text files
* text=auto

# SQL scripts (MySQL queries) should always be treated as text with LF endings
*.sql text eol=lf diff=sql

# CSV data files treated as text with LF endings
*.csv text eol=lf

# Power BI project files are binary (no diff/merge)
*.pbix binary

# Documentation normalized
*.md text eol=lf

# Logs treated as text
*.log text
