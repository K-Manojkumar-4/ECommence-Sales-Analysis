# ==============================
# PrimeViz E-Commerce Sales Analysis
# .gitattributes
# ==============================

# Force GitHub to count SQL files in the language stats
*.sql linguist-detectable=true
*.sql linguist-language=SQL

# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files
*.md      text
*.sql     text
*.csv     text
*.txt     text
*.json    text
*.yml     text
*.yaml    text

# Power BI files - treat as binary
*.pbix    binary
*.pbit    binary

# Images
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.svg     text

# Documents
*.pdf     binary
*.docx    binary
*.xlsx    binary

# Ensure shell scripts use LF
*.sh      text eol=lf
